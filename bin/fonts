#!/usr/bin/env python3
"""Fetch the fonts fonts.json lists into out/fonts/, each checked against
its checksum: EB Garamond Initials from CTAN, Spectral from the Google
Fonts revision levineuwirth.org pins, so the kept letter is the site's.

Usage: fonts
"""

import hashlib
import json
import sys
import urllib.request
from pathlib import Path as File

ROOT = File(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))
from fonts import FONTS

UA = "formschneider/0 (https://github.com/levineuwirth/formschneider)"


def main() -> None:
    FONTS.mkdir(parents=True, exist_ok=True)
    for name, src in json.loads((ROOT / "fonts.json").read_text()).items():
        f = FONTS / name
        if f.exists() and hashlib.sha256(f.read_bytes()).hexdigest() == src["sha256"]:
            continue
        req = urllib.request.Request(src["url"], headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=120) as r:
            data = r.read()
        if hashlib.sha256(data).hexdigest() != src["sha256"]:
            sys.exit(f"{name}: the file at {src['url']} is not the one fonts.json records")
        f.write_bytes(data)
        print(f"{name}: fetched")


if __name__ == "__main__":
    main()
