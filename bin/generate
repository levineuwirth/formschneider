#!/usr/bin/env python3
"""Make a run's requests. runs/NAME/spec.toml says what is asked of whom;
runs/NAME/records.jsonl records each request as it returns.

Without --go it only plans: the requests still to make, roughly what they
would cost by the spec's estimates, and every input (canvases, where the
model may draw, references) written to out/runs/NAME/inputs/ to look at
first. With --go it reads the keys from .env and sends them, breadth
first (every route and letter before a second attempt), recording each
before it goes out and stopping at the first error. A request that was
sent and never heard of again stops the run until the author has checked
the provider's usage and passes --abandon, which records that decision;
so does one that ended in a timeout or a lost connection.

Usage: uv run --extra openai --extra fal bin/generate NAME [--go] [--limit N] [--abandon]
"""

import argparse
import os
import sys
from pathlib import Path as File

ROOT = File(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))
import env
import run


def openai_images(model, **params):
    from openai_images import OpenAIImages
    return OpenAIImages(model, **params)


def fal_images(model, **params):
    from fal_images import FalImages
    return FalImages(model, **params)


ADAPTERS = {"openai": openai_images, "fal": fal_images}
KEYS = {"openai": "OPENAI_API_KEY", "fal": "FAL_KEY"}


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("name")
    ap.add_argument("--go", action="store_true", help="send the requests; without it, only plan")
    ap.add_argument("--limit", type=int, help="at most this many requests (0 or more)")
    ap.add_argument("--abandon", action="store_true",
                    help="record requests whose outcome is unknown as abandoned, and plan them again")
    a = ap.parse_args()
    if a.go:
        print("keys from .env:", ", ".join(env.load(ROOT / ".env")) or "none")
    spec = run.load(a.name)
    providers = {m["provider"] for m in spec["model"]}
    if "fal" in providers:
        from fal_images import check
        for m in (m for m in spec["model"] if m["provider"] == "fal"):
            check(m, len(spec["refs"]["letters"]))
    # every key before the first request, so a run does not stop for one partway
    if a.go and (missing := [KEYS[p] for p in sorted(providers) if not os.environ.get(KEYS[p])]):
        sys.exit(f"not in .env or the environment: {', '.join(missing)}")
    run.execute(spec, ADAPTERS, go=a.go, limit=a.limit, abandon=a.abandon)


if __name__ == "__main__":
    main()
