#!/usr/bin/env python3
"""Make a run's curation page: every finished initial as the dropcap of an
opening paragraph from levineuwirth.org, at the site's size (23 px
Spectral, three lines) and with its drawing-in, beside Keep and Reject,
and a judgment of each route as a set. The page (lib/curate.html) keeps
the decisions in its artifact's database: verdicts/<id>, sets/<route>.

Writes out/runs/NAME/curate.html, to publish as an artifact.

Usage: curate NAME [--title TITLE]
"""

import argparse
import html
import json
import sys
from pathlib import Path as File

ROOT = File(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))
import run
from specimens import ROUTES, TEXT, page as fill


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("name")
    ap.add_argument("--title")
    a = ap.parse_args()
    spec = run.load(a.name)
    out = ROOT / "out" / "runs" / spec["name"]
    measures = {m["id"]: m for m in json.loads((out / "finished" / "measures.json").read_text())}
    reqs = [r for r in run.requests(spec).values() if r["state"] == "saved"]
    items = []
    for r in sorted(reqs, key=lambda r: (r["route"], r["letter"], r["attempt"])):
        m = measures[r["id"]]
        items.append({"id": r["id"], "route": r["route"], "letter": r["letter"], "attempt": r["attempt"],
                      "kb": m["path_bytes"] / 1000, "budget": m["budget"],
                      "svg": (out / "finished" / f"{r['id']}.svg").read_text()})
    models = sorted({r["model"] for r in reqs})
    days = sorted({r["at"]["sent"][:10] for r in reqs})
    letters = [c for c in spec["letters"] if any(i["letter"] == c for i in items)]
    title = a.title or f"{spec['name']} curation"
    lede = (f"{len(items)} initials drawn by {', '.join(models)} on {', '.join(days)}: "
            f"{spec['attempts']} attempts at each of {len(letters)} letters by each route, all cut with "
            "the trial's fixed finishing. Each opens a paragraph from levineuwirth.org at the site's "
            "size, 23 px Spectral and three lines tall, and draws itself in as it does there. "
            "Click an initial to enlarge it.")
    data = {"routes": [r for r in ROUTES if r["key"] in spec["routes"]], "letters": letters,
            "items": items, "text": {c: TEXT[c][1] for c in letters},
            "sources": {c: TEXT[c][0] for c in letters}}
    page = fill("curate.html", TITLE=html.escape(title), LEDE=html.escape(lede),
                DATA=json.dumps(data).replace("</", "<\\/"))
    (out / "curate.html").write_text(page)
    print(f"{out / 'curate.html'}: {len(items)} initials, {len(page) / 1e6:.1f} MB")


if __name__ == "__main__":
    main()
