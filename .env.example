# Copy to .env (which git ignores) and fill in what you have.
OPENAI_API_KEY=        # platform.openai.com: GPT Image, direct
FAL_KEY=               # fal.ai/dashboard/keys: Gemini, Ideogram, FLUX, Recraft, Qwen on one key
HF_TOKEN=              # huggingface.co/settings/tokens: gated open weights for our own GPUs
# Optional
RECRAFT_API_TOKEN=     # recraft.ai: V3 inpainting with SVG out, which fal may not expose
GEMINI_API_KEY=        # aistudio.google.com/apikey: only for batch pricing at volume
